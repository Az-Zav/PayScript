COMPANY
    working_days 22
    hours_per_day 8
END

TAX
    BELOW 20833       = 0%
    20833 -> 33333    = 15%
    ABOVE 33333       = 1875 + 20%
END

EMPLOYEE john
    name "John Garcia"
    salary 28000
END

IF john.salary < 10000 THEN
    CONTRIBUTE john "SSS" 500
ELSE IF john.salary < 20000 THEN
    CONTRIBUTE john "SSS" 900
ELSE
    CONTRIBUTE john "SSS" 1350
END

PRINT john.name, john.tax, john.net

// expect-out: John Garcia 872.55 25777.45